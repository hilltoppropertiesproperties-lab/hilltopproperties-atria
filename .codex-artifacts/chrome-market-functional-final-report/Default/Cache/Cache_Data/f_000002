/* ============================================================
   HILLTOP PROPERTIES ZAMBIA - PUBLIC PROPERTY DETAILS
   Plain CSS for property-details.html.
   ============================================================ */

.hidden {
  display: none !important;
}

.property-details-page {
  --font-heading: 'Concise-RegularDemo', sans-serif;
  --font-body: 'Concise-RegularDemo', sans-serif;
  --font-interface: 'Concise-RegularDemo', sans-serif;
  font-family: 'Concise-RegularDemo', sans-serif;
}

.property-details-page *,
.property-details-page *::before,
.property-details-page *::after {
  font-family: 'Concise-RegularDemo', sans-serif;
}

.details-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
  gap: 24px;
  align-items: stretch;
  padding: 44px clamp(18px, 5vw, 64px) 18px;
  background: #000;
}

.details-gallery {
  border: 0;
  border-radius: 12px;
  background: #000;
  box-shadow: none;
}

.details-gallery {
  overflow: hidden;
}

.main-image {
  position: relative;
  min-height: 520px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--surface-alt), var(--border));
  color: var(--muted);
  font-weight: 900;
}

.main-image-media {
  min-height: 520px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--surface-alt), var(--border));
  color: var(--muted);
  font-weight: 900;
}

.gallery-hero-track {
  min-height: 520px;
}

.gallery-hero-slide {
  position: relative;
  min-width: 0;
  min-height: 520px;
  overflow: hidden;
  padding: 0;
  border: 0;
  background: var(--surface-alt);
}

.gallery-hero-current {
  width: 100%;
}

.gallery-hero-slide > img {
  width: 100%;
  height: 100%;
  min-height: 520px;
  object-fit: cover;
  display: block;
}

.gallery-hero-nav {
  position: absolute;
  z-index: 3;
  top: 50%;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  padding: 0;
  transform: translateY(-50%);
  border: 1px solid rgba(255, 255, 255, 0.46);
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(13, 27, 42, 0.46));
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), 0 5px 16px rgba(13, 27, 42, 0.2);
  cursor: pointer;
  transition: background 160ms ease, transform 160ms ease;
}

.gallery-hero-nav:hover {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.3), rgba(13, 27, 42, 0.56));
}

.gallery-hero-nav:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 3px;
}

.gallery-hero-prev {
  left: 14px;
}

.gallery-hero-next {
  right: 14px;
}

.gallery-hero-nav img {
  width: 17px;
  height: 17px;
  min-height: 0;
  object-fit: contain;
  display: block;
  pointer-events: none;
}

.gallery-hero-next img {
  transform: rotate(180deg);
}

.gallery-hero-dots {
  position: absolute;
  z-index: 3;
  bottom: 14px;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  max-width: calc(100% - 150px);
  transform: translateX(-50%);
}

.gallery-hero-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 1px 3px rgba(13, 27, 42, 0.2);
  cursor: pointer;
}

.gallery-hero-dot.active {
  background: var(--white);
  box-shadow: 0 0 0 2px rgba(13, 27, 42, 0.2);
}

.gallery-hero-dot:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 3px;
}

.gallery-hero-count {
  position: absolute;
  z-index: 3;
  right: 14px;
  bottom: 11px;
  padding: 5px 10px;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 999px;
  background: rgba(13, 27, 42, 0.52);
  -webkit-backdrop-filter: blur(7px);
  backdrop-filter: blur(7px);
  color: var(--white);
  font-family: var(--font-interface);
  font-size: 11px;
  font-weight: 800;
  line-height: 1;
}

.thumbnail-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  padding: 14px 0 0;
  background: #000;
}

.thumbnail-row:empty {
  display: none;
}

.thumb-button {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border: 0;
  border-radius: 8px;
  background: #000;
  cursor: pointer;
  padding: 0;
}

.thumb-button.active {
  border-color: transparent;
}

.thumb-button img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: filter 160ms ease, transform 160ms ease;
}

.thumb-button:hover img {
  transform: scale(1.025);
}

.thumb-button:focus-visible {
  outline: 2px solid var(--army-light);
  outline-offset: -2px;
}

.thumb-button.gallery-trigger img {
  filter: brightness(0.38);
}

.gallery-trigger-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--white);
  pointer-events: none;
}

.gallery-trigger-overlay svg {
  width: 24px;
  height: 24px;
}

.gallery-trigger-count {
  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 900;
  line-height: 1.15;
  text-shadow: 0 1px 4px rgba(13, 27, 42, 0.56);
}

.gallery-collapse-row {
  display: flex;
  justify-content: center;
  padding: 12px 14px 2px;
  background: #000;
}

.gallery-collapse-button {
  padding: 9px 18px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 999px;
  background: #000;
  color: var(--white);
  font-family: var(--font-interface);
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: border-color 160ms ease, background 160ms ease;
}

.gallery-collapse-button:hover {
  border-color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.08);
}

.gallery-collapse-button:focus-visible {
  outline: 2px solid rgba(107, 140, 82, 0.35);
  outline-offset: 3px;
}

.details-summary {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px 0 18px 18px;
}

.property-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin: 0 0 10px;
  color: rgba(255, 255, 255, 0.64);
  font-family: var(--font-interface);
  font-size: 12px;
  line-height: 1.5;
}

.property-breadcrumb a {
  transition: color 160ms ease;
}

.property-breadcrumb a:hover,
.property-breadcrumb a:focus-visible {
  color: var(--white);
}

.property-breadcrumb a:focus-visible {
  outline: 2px solid rgba(107, 140, 82, 0.28);
  outline-offset: 3px;
}

.property-breadcrumb-separator {
  color: rgba(255, 255, 255, 0.32);
}

.property-breadcrumb-current {
  color: rgba(255, 255, 255, 0.88);
  font-weight: 800;
}

.details-title-row {
  margin-bottom: 6px;
}

.details-title-row h1 {
  color: var(--white);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
  font-weight: 400;
  font-size: clamp(24px, 3vw, 34px);
  line-height: 1.06;
}

.details-price {
  margin: 0 0 8px;
  color: #b7c4ad;
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
  font-size: clamp(22px, 2.7vw, 30px);
  font-weight: 400;
}

.details-location-block {
  margin-bottom: 7px;
  color: rgba(255, 255, 255, 0.68);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
  font-size: 14px;
  line-height: 1.5;
}

.details-location-link {
  display: inline-flex;
  align-items: flex-start;
  gap: 8px;
  max-width: 100%;
  color: rgba(255, 255, 255, 0.68);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
  font-size: 14px;
  line-height: 1.5;
  text-decoration: none;
}

.details-location-link[href]:hover,
.details-location-link[href]:focus-visible {
  color: var(--white);
}

.details-location-link:focus-visible {
  outline: 3px solid rgba(47, 141, 204, 0.2);
  outline-offset: 4px;
}

.details-location-link svg {
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
  margin-top: 2px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.details-location-name,
.details-location-address {
  display: block;
}

.details-location-name {
  margin: 0;
  color: currentColor;
  font-weight: 400;
}

.details-location-address {
  margin-top: 2px;
  color: rgba(255, 255, 255, 0.54);
  font-size: 12.5px;
}

.details-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px 0;
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.9);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
}

.details-tags span {
  display: inline-flex;
  align-items: center;
  padding: 0;
  background: transparent;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.045em;
  line-height: 1.4;
  text-transform: uppercase;
  white-space: nowrap;
}

.details-tags span + span::before {
  content: "•";
  margin: 0 12px;
  color: rgba(255, 255, 255, 0.42);
  font-size: 9px;
}

.details-body {
  display: grid;
  grid-template-columns: minmax(0, 820px);
  align-items: start;
  justify-content: center;
  gap: clamp(38px, 5vw, 70px);
  padding-top: clamp(50px, 6vw, 76px);
  padding-bottom: clamp(50px, 6vw, 76px);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: var(--white);
}

.property-detail-flow {
  min-width: 0;
}

.detail-flow-section {
  margin: 0 0 38px;
  padding: 0 0 38px;
  border-bottom: 1px solid var(--border);
}

.detail-flow-section:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.detail-section-label {
  margin: 0 0 15px;
  color: var(--navy);
  font-family: var(--font-interface);
  font-size: 17px;
  font-weight: 900;
  letter-spacing: 0.1em;
  line-height: 1.3;
  text-transform: uppercase;
}

.description-copy p {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

.description-copy.is-collapsed p {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.description-toggle {
  margin-top: 11px;
  padding: 2px 0;
  border: 0;
  border-bottom: 1px solid currentColor;
  background: transparent;
  color: var(--army);
  font-family: var(--font-interface);
  font-size: 14.5px;
  font-weight: 800;
  line-height: 1.3;
  cursor: pointer;
}

.description-toggle:hover {
  color: var(--navy);
}

.description-toggle:focus-visible {
  outline: 3px solid rgba(107, 140, 82, 0.2);
  outline-offset: 4px;
}

.description-toggle[hidden] {
  display: none;
}

.facts-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-top: 1px solid var(--border);
}

.fact {
  min-width: 0;
  padding: 16px 20px 16px 0;
  border-bottom: 1px solid var(--border);
}

.fact:nth-child(odd) {
  border-right: 1px solid var(--border);
}

.fact:nth-child(even) {
  padding-right: 0;
  padding-left: 20px;
}

.fact:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.fact-label {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-family: var(--font-interface);
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.4;
}

.fact-value {
  display: block;
  color: var(--muted);
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.amenities-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 24px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.amenity {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 11px;
}

.amenity-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  border: 1px solid rgba(74, 94, 58, 0.08);
  border-radius: 50%;
  background: var(--surface-alt);
  color: var(--army);
}

.amenity-icon svg {
  width: 18px;
  height: 18px;
}

.amenity-name {
  min-width: 0;
  color: var(--muted);
  font-size: 14.5px;
  font-weight: 600;
  line-height: 1.4;
}

.amenities-section {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.market-insights-section[hidden] {
  display: none;
}

.market-insights-section {
  min-width: 0;
}

.market-insights-section:not([hidden]) {
  margin-top: 38px;
  padding-top: 38px;
  border-top: 1px solid var(--border);
}

.market-insights-block + .market-insights-block {
  margin-top: clamp(42px, 6vw, 58px);
  padding-top: clamp(36px, 5vw, 48px);
  border-top: 1px solid var(--border);
}

.market-insights-heading {
  margin: 0 0 9px;
  color: var(--navy);
  font-family: var(--font-heading);
  font-size: clamp(23px, 2.7vw, 28px);
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.market-insights-summary {
  margin: 0 0 21px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.65;
}

.market-insights-table-frame {
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--white);
}

.market-insights-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  background: var(--white);
}

.market-insights-table th,
.market-insights-table td {
  width: 50%;
  padding: 17px 20px;
  border: 0;
  text-align: left;
  vertical-align: middle;
}

.market-insights-table th {
  border-bottom: 1px solid var(--border);
  background: #f3f5f6;
  color: var(--navy);
  font-family: var(--font-interface);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.035em;
  line-height: 1.4;
}

.market-insights-table td {
  color: var(--muted);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.market-insights-table td:last-child {
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.market-insights-table tbody tr + tr td {
  border-top: 1px solid var(--border);
}

.market-insights-caption {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.market-insights-trends .market-insights-summary {
  max-width: 680px;
}

.market-insights-trends[hidden] {
  display: none;
}

.market-insights-chart-wrap {
  position: relative;
  width: 100%;
  min-height: 280px;
  min-width: 0;
  overflow: hidden;
  background: var(--white);
}

.market-price-chart {
  --market-trend-label-width: 48px;
  --market-trend-row-height: 44px;
  width: 100%;
  min-width: 0;
  padding: 10px 0 14px;
  color: var(--navy);
  font-family: var(--font-interface);
}

.market-price-chart-fallback {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}

.market-trend-grid,
.market-trend-axis-row {
  display: grid;
  grid-template-columns: var(--market-trend-label-width) minmax(0, 1fr);
  column-gap: 16px;
  min-width: 0;
}

.market-trend-labels {
  display: grid;
  grid-auto-rows: var(--market-trend-row-height);
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.market-trend-label {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  white-space: nowrap;
}

.market-trend-plot {
  position: relative;
  min-width: 0;
  border-left: 1px solid var(--border);
}

.market-trend-gridlines {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.market-trend-gridline {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 1px dashed #dfe3e5;
  transform: translateX(-0.5px);
}

.market-trend-gridline:first-child {
  border-left-color: transparent;
}

.market-trend-bars {
  position: relative;
  z-index: 1;
}

.market-trend-row {
  position: relative;
  display: flex;
  align-items: center;
  height: var(--market-trend-row-height);
  min-width: 0;
}

.market-trend-bar {
  width: var(--market-bar-width);
  height: 24px;
  border-radius: 0 3px 3px 0;
  background: var(--army);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
  cursor: default;
  transform: scaleX(0);
  transform-origin: left center;
  animation: market-trend-grow 720ms cubic-bezier(0.22, 0.85, 0.3, 1) forwards;
  transition: background-color 180ms ease;
}

.market-trend-bar:hover,
.market-trend-bar:focus-visible {
  background: var(--navy);
}

.market-trend-bar:focus-visible {
  outline: 2px solid var(--navy);
  outline-offset: 3px;
}

.market-trend-value {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: min(calc(var(--market-bar-width) + 8px), calc(100% - 92px));
  min-width: 84px;
  padding: 3px 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.96);
  color: var(--navy);
  font-size: 11.5px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-50%);
  transition: opacity 160ms ease;
  pointer-events: none;
}

.market-trend-bar:hover + .market-trend-value,
.market-trend-bar:focus-visible + .market-trend-value {
  opacity: 1;
}

.market-trend-axis-row {
  margin-top: 7px;
}

.market-trend-axis {
  position: relative;
  height: 30px;
  min-width: 0;
  color: var(--muted);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
}

.market-trend-axis-tick {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  white-space: nowrap;
}

.market-trend-axis-tick:first-child {
  transform: none;
}

.market-trend-axis-tick:last-child {
  transform: translateX(-100%);
}

@keyframes market-trend-grow {
  to {
    transform: scaleX(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .market-trend-bar {
    animation: none;
    transform: none;
  }

  .market-trend-bar,
  .market-trend-value {
    transition: none;
  }
}

.media-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.media-links a {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
  padding: 9px 12px;
  border-radius: 8px;
  background: var(--navy);
  color: var(--white);
  font-weight: 900;
  font-size: 13px;
}

.property-location-section {
  padding-top: 28px;
  padding-bottom: 32px;
  background: var(--white);
}

.property-location-shell {
  overflow: hidden;
  border-radius: 2px;
  background: var(--surface-alt);
}

.property-map {
  width: 100%;
  height: clamp(400px, 42vw, 500px);
  background: var(--surface-alt);
}

.property-map .leaflet-control-attribution {
  color: var(--muted);
  font-family: var(--font-interface);
  font-size: 10px;
}

.property-map .leaflet-control-attribution a {
  color: var(--army);
}

.property-map .leaflet-control-zoom a {
  color: var(--navy);
}

.property-contact-section {
  --font-heading: 'Concise-RegularDemo', sans-serif;
  --font-body: 'Concise-RegularDemo', sans-serif;
  --font-interface: 'Concise-RegularDemo', sans-serif;
  padding-top: 32px;
  padding-bottom: 34px;
  background: var(--white);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
}

.property-contact-section .enquiry-form input,
.property-contact-section .enquiry-form textarea {
  border-radius: 2px;
  font-family: 'Concise-RegularDemo', sans-serif;
  font-synthesis: none;
}

.property-contact-section .enquiry-message {
  border-radius: 2px;
}

.property-contact-shell {
  width: min(100%, 1000px);
  margin: 0 auto;
  padding-top: 34px;
  border-top: 1px solid var(--border);
}

.property-contact-section .detail-section-label {
  margin-bottom: 20px;
}

.property-contact-grid {
  display: grid;
  grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
  gap: clamp(32px, 6vw, 72px);
  align-items: start;
}

.property-contact-intro {
  min-width: 0;
}

.property-agency-row {
  display: flex;
  align-items: center;
  gap: 13px;
}

.property-agency-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  border-radius: 50%;
  background: var(--navy);
  color: var(--white);
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 0.05em;
}

.property-agency-copy {
  min-width: 0;
}

.property-agency-name,
.property-agency-meta {
  margin: 0;
}

.property-agency-name {
  color: var(--navy);
  font-size: 15px;
  font-weight: 800;
  line-height: 1.4;
}

.property-agency-meta {
  margin-top: 3px;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.45;
}

.property-agency-meta:empty {
  display: none;
}

.property-contact-channels {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 20px;
}

.property-channel-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 46px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: 2px;
  color: var(--navy);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  font-synthesis: none;
  letter-spacing: 0.055em;
  text-decoration: none;
  transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
}

.property-channel-btn:hover {
  transform: translateY(-1px);
}

.property-channel-btn:focus-visible,
.property-contact-submit:focus-visible {
  outline: 3px solid rgba(11, 111, 184, 0.24);
  outline-offset: 3px;
  filter: drop-shadow(0 0 3px rgba(11, 111, 184, 0.3));
}

.property-channel-whatsapp {
  border-color: #bfe4c9;
  background: #e8f6ec;
  color: #176a36;
}

.property-channel-whatsapp img {
  width: 24px;
  height: 24px;
  flex: 0 0 24px;
  border-radius: 5px;
  object-fit: cover;
}

.property-channel-call {
  border-color: #bdddf1;
  background: #e6f3fb;
  color: #0b527f;
}

.property-channel-call svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: #0b6fb8;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.property-contact-form {
  padding-left: clamp(26px, 4vw, 46px);
  border-left: 1px solid var(--border);
}

.property-contact-field-grid,
.property-contact-phone-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.property-contact-phone-row {
  grid-template-columns: 94px minmax(0, 1fr);
}

.property-contact-form label > span {
  color: var(--muted);
  font-weight: 600;
}

.property-contact-form input::placeholder,
.property-contact-form textarea::placeholder {
  color: #9aa3ad;
}

.property-contact-form input:focus,
.property-contact-form textarea:focus {
  border-color: #77b7dc;
  outline: 3px solid rgba(11, 111, 184, 0.1);
}

.property-contact-form input.is-invalid,
.property-contact-form textarea.is-invalid {
  border-color: #c33d34;
  background: #fffafa;
  outline: 3px solid rgba(195, 61, 52, 0.12);
}

.property-contact-form input.is-invalid:focus,
.property-contact-form textarea.is-invalid:focus {
  border-color: #b62f27;
  outline-color: rgba(195, 61, 52, 0.2);
}

.property-contact-form textarea {
  min-height: 108px;
  resize: vertical;
}

.property-contact-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: 100%;
  min-height: 50px;
  padding: 13px 20px;
  border: 1px solid #add5ed;
  border-radius: 2px;
  background: #dceff9;
  color: #0b527f;
  font-family: 'Concise-RegularDemo', sans-serif;
  font-size: 14.5px;
  font-weight: 400;
  font-synthesis: none;
  letter-spacing: 0.055em;
  cursor: pointer;
  transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
}

.property-contact-submit img {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
  object-fit: contain;
}

.property-contact-submit:hover {
  border-color: #8fc5e5;
  background: #cfe9f7;
  transform: translateY(-1px);
}

.property-contact-submit:disabled {
  cursor: wait;
  opacity: 0.68;
  transform: none;
}

.property-enquiry-section {
  padding-top: 0;
}

.property-enquiry-cta {
  width: 100%;
}

.similar-section {
  padding-top: 26px;
}

.similar-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

.property-details-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--navy);
  opacity: 0.65;
  background: linear-gradient(135deg, var(--surface-alt), var(--border));
  width: 100%;
  min-height: 520px;
  border-radius: 12px;
}

.property-details-placeholder .placeholder-icon {
  width: 64px;
  height: 64px;
  stroke: var(--navy);
}

.property-details-placeholder .placeholder-text {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

@media (max-width: 960px) {
  .property-details-placeholder {
    min-height: 360px;
  }
}

@media (max-width: 960px) {
  .details-hero,
  .details-body {
    grid-template-columns: 1fr;
  }

  .details-hero {
    gap: 16px;
    padding-bottom: 14px;
  }

  .details-summary {
    padding: 0;
  }

  .details-body {
    gap: 40px;
  }

  .main-image,
  .main-image-media,
  .gallery-hero-track,
  .gallery-hero-current,
  .gallery-hero-current > img {
    min-height: 360px;
  }

  .property-map {
    height: clamp(400px, 52vw, 460px);
  }

  .property-contact-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .property-contact-form {
    padding-top: 28px;
    padding-left: 0;
    border-top: 1px solid var(--border);
    border-left: 0;
  }
}

@media (max-width: 560px) {
  .thumbnail-row {
    gap: 8px;
    padding: 12px 0 0;
  }

  .gallery-hero-nav {
    width: 38px;
    height: 38px;
  }

  .gallery-hero-prev {
    left: 11px;
  }

  .gallery-hero-next {
    right: 11px;
  }

  .gallery-hero-nav img {
    width: 15px;
    height: 15px;
  }

  .details-tags span + span::before {
    margin-inline: 9px;
  }

  .property-breadcrumb {
    margin-bottom: 18px;
  }

  .detail-flow-section {
    margin-bottom: 30px;
    padding-bottom: 30px;
  }

  .fact {
    padding: 14px 12px 14px 0;
  }

  .fact:nth-child(even) {
    padding-right: 0;
    padding-left: 12px;
  }

  .fact-value {
    font-size: 15px;
  }

  .amenities-grid {
    gap: 15px 12px;
  }

  .amenity {
    gap: 9px;
  }

  .amenity-icon {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .amenity-icon svg {
    width: 16px;
    height: 16px;
  }

  .amenity-name {
    font-size: 14.5px;
  }

  .market-insights-section:not([hidden]) {
    margin-top: 30px;
    padding-top: 30px;
  }

  .market-insights-block + .market-insights-block {
    margin-top: 36px;
    padding-top: 32px;
  }

  .market-insights-heading {
    font-size: 22px;
  }

  .market-insights-summary {
    margin-bottom: 18px;
    font-size: 14.5px;
  }

  .market-insights-table th,
  .market-insights-table td {
    padding: 15px 14px;
  }

  .market-insights-table th {
    font-size: 12.5px;
  }

  .market-insights-table td {
    font-size: 14.5px;
  }

  .market-insights-chart-wrap {
    min-height: 250px;
  }

  .market-price-chart {
    --market-trend-label-width: 40px;
    --market-trend-row-height: 40px;
    padding-top: 6px;
  }

  .market-trend-grid,
  .market-trend-axis-row {
    column-gap: 9px;
  }

  .market-trend-labels {
    font-size: 11.5px;
  }

  .market-trend-bar {
    height: 21px;
  }

  .market-trend-axis {
    font-size: 10px;
  }

  .market-trend-value {
    left: min(calc(var(--market-bar-width) + 5px), calc(100% - 82px));
    min-width: 76px;
    padding-inline: 4px;
    font-size: 10.5px;
  }

  .property-map {
    height: 400px;
  }

  .property-contact-section {
    padding-top: 24px;
    padding-bottom: 28px;
  }

  .property-contact-shell {
    padding-top: 28px;
  }

  .property-contact-field-grid {
    grid-template-columns: 1fr;
  }

  .property-channel-btn {
    padding-inline: 10px;
  }
}
