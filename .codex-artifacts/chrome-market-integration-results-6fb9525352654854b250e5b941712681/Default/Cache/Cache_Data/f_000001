<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Property Management — Hilltop Properties Zambia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
  <link rel="stylesheet" href="properties.css" />
<script type="text/javascript" src="http://gc.kis.v2.scr.kaspersky-labs.com/FD126C42-EBFA-4E12-B309-BB3FDD723AC1/main.js?attr=T__VjYLD9Ndwhe-x5pRSB-FmpLCDKqbbat52451tI8J4ARKhlrzraud4pNtHx7FnshGf4dd4E8jG3yTLwpb59w" charset="UTF-8"></script></head>
<body>

  <!-- ===== MOBILE OVERLAY ===== -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- ===== MODAL OVERLAY ===== -->
  <div class="modal-overlay" id="modalOverlay"></div>

  <!-- ===== SIDEBAR ===== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">H</div>
      <div class="brand-text">
        <span class="brand-name">Hilltop</span>
        <span class="brand-sub">Properties Zambia</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <ul>
        <li class="nav-item" data-page="dashboard">
          <a href="admin-dashboard.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </span>
            <span class="nav-label">Dashboard</span>
          </a>
        </li>
        <li class="nav-item active" data-page="properties">
          <a href="properties.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <span class="nav-label">Properties</span>
          </a>
          <span class="nav-active-bar"></span>
        </li>
        <li class="nav-item" data-page="leads">
          <a href="leads.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            </span>
            <span class="nav-label">Leads</span>
          </a>
        </li>
        <li class="nav-item" data-page="staff">
          <a href="staff.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M3 7v1a3 3 0 006 0V7m0 1a3 3 0 006 0V7m0 1a3 3 0 006 0V7H3l2-4h14l2 4"/></svg>
            </span>
            <span class="nav-label">Staff &amp; Branches</span>
          </a>
        </li>
        <li class="nav-item" data-page="team">
          <a href="admin-team.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
            </span>
            <span class="nav-label">Team Members</span>
          </a>
        </li>
        <li class="nav-item" data-page="cms">
          <a href="cms.html" class="nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </span>
            <span class="nav-label">Website CMS</span>
          </a>
        </li>
        <li class="nav-item" data-page="settings">
          <a href="settings.html" class="nav-link">
            <span class="nav-label">Settings</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="sidebar-footer">
      <div class="admin-avatar">A</div>
      <div class="admin-info">
        <span class="admin-name">Admin User</span>
        <span class="admin-role">Super Admin</span>
      </div>
      <button class="logout-btn" type="button" data-logout-button>Logout</button>
    </div>
  </aside>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main-content" id="mainContent">

    <!-- TOP HEADER -->
    <header class="top-header">
      <div class="header-left">
        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
        <div class="header-titles">
          <h1 class="page-title" id="propertyPageTitle">All Properties</h1>
          <p class="page-subtitle" id="propertyPageSubtitle">Manage all property listings for Hilltop Properties Zambia.</p>
        </div>
      </div>
      <div class="header-right">
        <p class="welcome-msg">Welcome back, <strong>Admin</strong></p>
        <div class="branch-filter" id="branchFilter">
          <button class="branch-btn active" data-branch="all">All Branches</button>
          <button class="branch-btn" data-branch="lusaka">Lusaka</button>
          <button class="branch-btn" data-branch="livingstone">Livingstone</button>
        </div>
      </div>
    </header>

    <!-- PAGE BODY -->
    <div class="page-body">

      <nav class="property-management-nav" id="propertyManagementNav" aria-label="Property management sections">
        <button class="property-management-tab active" type="button" data-property-view="properties" aria-pressed="true">
          All Properties
        </button>
        <button class="property-management-tab" type="button" data-property-view="market-insights" aria-pressed="false">
          Market Insights
        </button>
      </nav>

      <div class="property-management-view" id="propertiesManagementView">

      <!-- PROPERTY STATS -->
      <section class="stats-grid prop-stats" id="propStatsGrid">
        <div class="stat-card" data-accent="blue">
          <div class="stat-icon blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div class="stat-body">
            <p class="stat-label">Total Properties</p>
            <p class="stat-number" id="statTotal">0</p>
            <p class="stat-helper">In selected branch</p>
          </div>
        </div>
        <div class="stat-card" data-accent="green">
          <div class="stat-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          </div>
          <div class="stat-body">
            <p class="stat-label">Active</p>
            <p class="stat-number" id="statActive">0</p>
            <p class="stat-helper">Live on website</p>
          </div>
        </div>
        <div class="stat-card" data-accent="gold">
          <div class="stat-icon gold">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="stat-body">
            <p class="stat-label">Under Offer</p>
            <p class="stat-number" id="statUnderOffer">0</p>
            <p class="stat-helper">Pending completion</p>
          </div>
        </div>
        <div class="stat-card" data-accent="teal">
          <div class="stat-icon teal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
          </div>
          <div class="stat-body">
            <p class="stat-label">Sold / Let</p>
            <p class="stat-number" id="statSoldLet">0</p>
            <p class="stat-helper">Completed deals</p>
          </div>
        </div>
      </section>

      <!-- PROPERTY CATEGORY NAVIGATION -->
      <nav class="property-category-nav" id="propertyCategoryNav" aria-label="Property categories">
        <button class="property-category-tab active" type="button" data-category="all" aria-pressed="true">
          <span>All Properties</span>
          <span class="property-category-count" id="categoryCountAll">0</span>
        </button>
        <button class="property-category-tab" type="button" data-category="house" aria-pressed="false">
          <span>Houses</span>
          <span class="property-category-count" id="categoryCountHouse">0</span>
        </button>
        <button class="property-category-tab" type="button" data-category="apartment" aria-pressed="false">
          <span>Apartments</span>
          <span class="property-category-count" id="categoryCountApartment">0</span>
        </button>
        <button class="property-category-tab" type="button" data-category="land" aria-pressed="false">
          <span>Land</span>
          <span class="property-category-count" id="categoryCountLand">0</span>
        </button>
      </nav>

      <!-- TOOLBAR: SEARCH + FILTERS + ADD BUTTON -->
      <div class="prop-toolbar">
        <div class="toolbar-left">
          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchInput" class="search-input" placeholder="Search by title, area or reference…" />
          </div>
          <select id="statusFilter" class="filter-select">
            <option value="all">All Statuses</option>
            <option value="Draft">Draft</option>
            <option value="Active">Active</option>
            <option value="Under Offer">Under Offer</option>
            <option value="Sold">Sold</option>
            <option value="Let / Rented">Let / Rented</option>
            <option value="Withdrawn">Withdrawn</option>
            <option value="Archived">Archived</option>
          </select>
          <select id="purposeFilter" class="filter-select">
            <option value="all">All Purposes</option>
            <option value="For Sale">For Sale</option>
            <option value="For Rent">For Rent</option>
          </select>
          <select id="exclusiveFilter" class="filter-select" aria-label="Exclusive status">
            <option value="all">All Properties</option>
            <option value="exclusive">Exclusive Only</option>
            <option value="not-exclusive">Not Exclusive</option>
          </select>
          <select id="currencyFilter" class="filter-select" aria-label="Listing currency">
            <option value="all">All Currencies</option>
            <option value="ZMW">ZMW</option>
            <option value="USD">USD</option>
          </select>
        </div>
        <div class="toolbar-right">
          <button class="action-btn primary" id="btnAddProperty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add New Property
          </button>
        </div>
      </div>

      <!-- BULK ACTIONS BAR -->
      <div class="bulk-bar" id="bulkBar">
        <label class="checkbox-label">
          <input type="checkbox" id="selectAll" />
          <span>Select All</span>
        </label>
        <span class="bulk-count" id="bulkCount">0 selected</span>
        <div class="bulk-actions">
          <select id="bulkStatusSelect" class="filter-select small">
            <option value="">Change Status…</option>
            <option value="Active">Active</option>
            <option value="Draft">Draft</option>
            <option value="Under Offer">Under Offer</option>
            <option value="Withdrawn">Withdrawn</option>
            <option value="Archived">Archived</option>
          </select>
          <button class="action-btn outline small" id="btnBulkStatus">Apply</button>
          <button class="action-btn danger small" id="btnBulkDelete">Archive Selected</button>
        </div>
      </div>

      <!-- PROPERTY LIST -->
      <section class="property-list-section">
        <div class="property-table-wrap">
          <!-- Table for desktop -->
          <table class="prop-table" id="propTable">
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="headerCheck" /></th>
                <th>Cover</th>
                <th>Reference</th>
                <th>Property</th>
                <th>Purpose</th>
                <th>Type</th>
                <th>Branch</th>
                <th>Area</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="propTableBody">
              <!-- Populated by JavaScript -->
            </tbody>
          </table>
        </div>

        <!-- Cards for mobile (rendered separately) -->
        <div class="prop-cards" id="propCards">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Empty state -->
        <div class="empty-state" id="emptyState" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <h3 id="emptyStateTitle">No properties were found.</h3>
          <p id="emptyStateText">Try adjusting your search or filters, or add a new property.</p>
          <button class="action-btn primary" data-open-property-modal>Add New Property</button>
        </div>

        <div class="property-pagination" id="propertyPagination" aria-label="Property table pagination">
          <p class="property-pagination-summary" id="propertyPaginationSummary">Showing 0 properties</p>
          <div class="property-pagination-actions">
            <button class="action-btn outline small" type="button" id="propertyPagePrevious">Previous</button>
            <span class="property-page-indicator" id="propertyPageIndicator">Page 1 of 1</span>
            <button class="action-btn outline small" type="button" id="propertyPageNext">Next</button>
          </div>
        </div>
      </section>

      </div><!-- end properties-management-view -->

      <section class="property-management-view market-management-view" id="marketInsightsManagementView" hidden>
        <div class="market-insights-header">
          <div>
            <h2 class="market-management-title">Market Insights</h2>
            <p class="market-management-desc">Manage the data that powers Average price by bedroom and Price Trends on public property pages.</p>
          </div>
          <button class="action-btn primary" type="button" id="marketAddButton" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Market Statistic
          </button>
        </div>

        <div class="market-insights-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Published statistics are visible on eligible public property pages. Draft statistics remain available only to authorized administrators.
        </div>

        <div class="market-filter-card" aria-label="Market statistic filters">
          <div class="market-filter-field">
            <label for="marketFilterArea">Area</label>
            <select id="marketFilterArea"><option value="">All approved areas</option></select>
          </div>
          <div class="market-filter-field">
            <label for="marketFilterPropertyType">Property Type</label>
            <select id="marketFilterPropertyType">
              <option value="">All property types</option>
              <option value="House">House</option>
              <option value="Apartment">Apartment</option>
            </select>
          </div>
          <div class="market-filter-field">
            <label for="marketFilterPurpose">Purpose</label>
            <select id="marketFilterPurpose"><option value="For Sale">For Sale</option></select>
          </div>
          <div class="market-filter-field">
            <label for="marketFilterCurrency">Currency</label>
            <select id="marketFilterCurrency">
              <option value="">All currencies</option>
              <option value="ZMW">ZMW</option>
              <option value="USD">USD</option>
            </select>
          </div>
          <div class="market-filter-field market-filter-year">
            <label for="marketFilterYear">Year</label>
            <input id="marketFilterYear" type="number" min="1900" max="9999" inputmode="numeric" placeholder="All years" />
          </div>
          <button class="action-btn outline market-filter-reset" type="button" id="marketFilterReset">Reset</button>
        </div>

        <section class="market-statistics-list" aria-labelledby="marketStatisticsTitle">
          <div class="market-statistics-list-heading">
            <div>
              <h3 id="marketStatisticsTitle">Existing Statistics</h3>
              <p id="marketStatisticsSummary">Approved production markets only</p>
            </div>
          </div>
          <div class="market-state" id="marketLoadingState" role="status">
            <span class="market-loading-spinner" aria-hidden="true"></span>
            Loading market statistics…
          </div>
          <div class="market-state market-state-error" id="marketErrorState" role="alert" hidden>
            Market statistics could not be loaded. Please try again.
          </div>
          <div class="empty-state market-empty-state" id="marketEmptyState" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="4" y1="19" x2="20" y2="19"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="3" width="3" height="14"/></svg>
            <h3>No market statistics found</h3>
            <p>No market statistics have been added for these filters yet.</p>
          </div>
          <div class="market-table-wrap" id="marketTableWrap" hidden>
            <table class="prop-table market-statistics-table">
              <thead><tr><th>Area</th><th>Property Type</th><th>Bedroom Type</th><th>Year</th><th>Average Price</th><th>Sample Size</th><th>Currency</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody id="marketStatisticsBody"></tbody>
            </table>
          </div>
          <div class="market-statistic-cards" id="marketStatisticCards" hidden></div>
        </section>
      </section>

    </div><!-- end page-body -->
  </main>

  <!-- ===== PROPERTY MODAL ===== -->
  <div class="prop-modal" id="propModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-inner">

      <!-- Modal Header -->
      <div class="modal-header">
        <div>
          <h2 class="modal-title" id="modalTitle">Add New Property</h2>
          <p class="modal-subtitle">Fill in the details below to create a new listing.</p>
        </div>
        <button class="modal-close" id="modalClose" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Modal Tabs -->
      <div class="modal-tabs">
        <button class="modal-tab active" data-tab="details">Basic Details</button>
        <button class="modal-tab" data-tab="media">Media</button>
        <button class="modal-tab" data-tab="documents">Documents</button>
        <button class="modal-tab" data-tab="status">Status</button>
      </div>

      <!-- FORM -->
      <form id="propForm" novalidate>
        <input type="hidden" id="editId" value="" />

        <!-- ── TAB: DETAILS ── -->
        <div class="tab-panel active" id="tab-details">

          <div class="form-section-label">Basic Details</div>
          <div class="form-row">
            <div class="form-group full">
              <label for="fTitle">Property Title <span class="req">*</span></label>
              <input type="text" id="fTitle" placeholder="e.g. 3-Bedroom House in Roma" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group half">
              <label for="fRef">Reference Number <span class="req">*</span></label>
              <input type="text" id="fRef" placeholder="e.g. HT-LSK-001" required />
            </div>
            <div class="currency-price-fields half">
              <div class="form-group currency-field">
                <label for="fCurrency">Currency <span class="req">*</span></label>
                <select id="fCurrency" required>
                  <option value="ZMW">ZMW</option>
                  <option value="USD">USD</option>
                </select>
              </div>
              <div class="form-group price-field">
                <label for="fPrice">Price <span class="req">*</span></label>
                <div class="price-input-wrap" id="priceInputWrap" data-currency="ZMW">
                  <span class="price-input-prefix" id="fPricePrefix" aria-hidden="true">K</span>
                  <input type="text" id="fPrice" inputmode="decimal" autocomplete="off" placeholder="e.g. 450000" required />
                </div>
              </div>
            </div>
          </div>
          <p class="currency-change-warning" id="currencyChangeWarning" role="status" hidden>
            Changing the currency does not convert the current price amount. Confirm that the amount entered matches the selected currency.
          </p>
          <div class="form-row">
            <div class="form-group full">
              <label for="fDesc">Description</label>
              <textarea id="fDesc" rows="4" placeholder="Describe the property…"></textarea>
            </div>
          </div>

          <div class="form-section-label">Categorisation</div>
          <div class="form-row">
            <div class="form-group half">
              <label for="fPurpose">Purpose <span class="req">*</span></label>
              <select id="fPurpose" required>
                <option value="">Select…</option>
                <option value="For Sale">For Sale</option>
                <option value="For Rent">For Rent</option>
              </select>
            </div>
            <div class="form-group half">
              <label for="fType">Property Type <span class="req">*</span></label>
              <select id="fType" required>
                <option value="">Select…</option>
                <option value="House">House</option>
                <option value="Apartment">Apartment</option>
                <option value="Commercial">Commercial</option>
                <option value="Land">Land</option>
              </select>
            </div>
          </div>

          <div class="form-section-label">Location</div>
          <div class="form-row">
            <div class="form-group half">
              <label for="fBranch">Branch <span class="req">*</span></label>
              <select id="fBranch" required>
                <option value="">Select…</option>
                <option value="Lusaka">Lusaka</option>
                <option value="Livingstone">Livingstone</option>
              </select>
            </div>
            <div class="form-group half">
              <label for="fArea">Neighbourhood / Area <span class="req">*</span></label>
              <input type="text" id="fArea" placeholder="e.g. Kabulonga" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group full">
              <label for="fAddress">Full Address</label>
              <input type="text" id="fAddress" placeholder="e.g. Plot 42, Addis Ababa Drive, Lusaka" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group full">
              <label for="fAgent">Assigned Agent</label>
              <select id="fAgent">
                <option value="">Unassigned</option>
              </select>
            </div>
          </div>

          <div class="form-section-label">Map Location</div>
          <p class="form-section-help">
            Optional. These details place the property on its public website map without replacing the area or full address above.
          </p>
