    --logo-scale: 1.15;
  }
}

@media (max-width: 640px) {
  .logo-bridge {
    padding: 5rem 0 3.5rem;
  }

  .logo-bridge__intro {
    margin-bottom: 2rem;
  }

  .logo-bridge__grid {
    width: min(100%, calc(100% - 2rem));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .logo-bridge__grid[data-logo-count="1"],
  .logo-bridge__grid[data-logo-count="2"],
  .logo-bridge__grid[data-logo-count="3"] {
    display: grid;
  }

  .logo-bridge__grid[data-logo-count="1"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .logo-bridge__grid[data-logo-count="2"],
  .logo-bridge__grid[data-logo-count="3"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .logo-bridge__item {
    --logo-width: 195px;
    --logo-height: 110px;
    --logo-scale: 1.03;
    min-height: 120px;
  }

  .logo-bridge__item[data-logo-name*="smart"] {
    --logo-width: 220px;
    --logo-height: 115px;
    --logo-scale: 1.08;
  }

  .logo-bridge__item[data-logo-name*="electric"] {
    --logo-width: 200px;
    --logo-height: 120px;
    --logo-scale: 1.10;
  }

  .logo-bridge__item[data-logo-name*="hilltop"] {
    --logo-width: 215px;
    --logo-height: 115px;
    --logo-scale: 1.07;
  }
}

@media (prefers-reduced-motion: reduce) {
  .logo-bridge *,
  .logo-bridge *::before,
  .logo-bridge *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    transition-delay: 0ms !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }

  .logo-bridge--animate .logo-bridge__intro,
  .logo-bridge--animate .logo-bridge__item {
    opacity: 1;
    transform: none;
  }
}

/* =========================================================
   BUSINESS SNAPSHOT SECTION
   ========================================================= */
.business-snapshot {
  --snapshot-overlay: .72;
  position: relative;
  isolation: isolate;
  width: min(calc(100% - 3rem), 1390px);
  margin: clamp(72px, 8vw, 130px) auto;
  overflow: hidden;
  background: var(--color-navy);
  color: var(--color-white);
}

.business-snapshot::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .055;
  background-image:
    linear-gradient(rgba(255, 255, 255, .28) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, .28) 1px, transparent 1px);
  background-size: 64px 64px;
  animation: snapshotGridDrift 28s linear infinite;
  content: "";
}

.business-snapshot::after {
  position: absolute;
  top: -320px;
  left: -260px;
  z-index: 1;
  width: 760px;
  height: 760px;
  pointer-events: none;
  border-radius: 50%;
  opacity: .12;
  filter: blur(100px);
  background: radial-gradient(circle, rgba(72, 168, 216, .75) 0%, rgba(72, 168, 216, 0) 70%);
  animation: snapshotGlow 24s ease-in-out infinite alternate;
  content: "";
}

.business-snapshot__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-position: center;
  background-size: cover;
}

.business-snapshot__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.business-snapshot__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: rgba(7, 35, 69, var(--snapshot-overlay));
}

.business-snapshot__content {
  position: relative;
  z-index: 2;
}

.business-snapshot--video-active::before { opacity: .015; }
.business-snapshot--video-active::after { opacity: .04; }

.business-snapshot__inner {
  padding: clamp(64px, 8vw, 120px);
  display: grid;
  grid-template-columns: minmax(280px, .85fr) minmax(0, 1.15fr);
  gap: clamp(60px, 8vw, 150px);
  align-items: start;
}

.business-snapshot__eyebrow {
  margin: 0 0 24px;
  color: rgba(255, 255, 255, .82);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.business-snapshot__intro {
  max-width: 30rem;
}

.business-snapshot__intro p:not(.business-snapshot__eyebrow) {
  font-size: clamp(1rem, 1.1vw, 1.125rem);
  line-height: 1.5;
  font-weight: 400;
  color: rgba(255, 255, 255, .82);
}

.business-snapshot__intro h2 {
  margin: 0;
  color: var(--color-white);
  font-family: inherit;
  font-size: clamp(2.8rem, 4vw, 4.8rem);
  font-weight: 400;
  line-height: 1.02;
  letter-spacing: -.035em;
}

.business-snapshot__summary {
  max-width: 34rem;
  margin: 30px 0 0;
}

.business-snapshot__metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(48px, 6vw, 96px);
}

.business-metric strong {
  display: block;
  color: var(--color-white);
  font-size: clamp(3.5rem, 6vw, 7rem);
  font-weight: 300;
  line-height: .95;
  letter-spacing: -.04em;
}

.business-metric p {
  max-width: 22rem;
  margin: 14px 0 0;
  color: rgba(255, 255, 255, .78);
  font-size: clamp(1rem, 1.3vw, 1.35rem);
  line-height: 1.35;
  font-weight: 400;
}

@keyframes snapshotGridDrift {
  from { background-position: 0 0, 0 0; }
  to { background-position: 64px 32px, 64px 32px; }
}

@keyframes snapshotGlow {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to { transform: translate3d(55vw, 120px, 0) scale(1.08); }
}

