/* =========================================================
   LOGO BRIDGE
   ========================================================= */
.logo-bridge {
  overflow: hidden;
  padding: clamp(5rem, 8vw, 7rem) 0 clamp(3.25rem, 5vw, 4.5rem);
  border-top: 1px solid rgba(8, 35, 69, .1);
  border-bottom: 1px solid rgba(8, 35, 69, .1);
  background: #fff;
}

.logo-bridge__inner {
  width: 100%;
  margin-inline: auto;
}

.logo-bridge__intro {
  width: min(56rem, calc(100% - 3rem));
  max-width: 56rem;
  margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
  text-align: center;
}

.logo-bridge__eyebrow {
  margin: 0 0 1.25rem;
  color: var(--color-navy);
  font-size: .8125rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.logo-bridge__intro h2 {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(2.5rem, 4.5vw, 4.75rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -.03em;
}

.logo-bridge__description {
  max-width: 38rem;
  margin: 1.75rem auto 0;
  color: rgba(8, 35, 69, .72);
  font-size: clamp(1rem, 1.2vw, 1.125rem);
  line-height: 1.6;
}

.logo-bridge__grid {
  width: min(1440px, calc(100% - 4rem));
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  gap: clamp(4rem, 6vw, 6.5rem) clamp(2.5rem, 4vw, 4.5rem);
  padding: 0;
  list-style: none;
}

.logo-bridge__grid[data-logo-count="1"] {
  display: grid;
  grid-template-columns: minmax(280px, 340px);
  justify-content: center;
  justify-items: center;
}

.logo-bridge__grid[data-logo-count="2"] {
  display: grid;
  grid-template-columns: repeat(2, minmax(280px, 340px));
  justify-content: center;
  justify-items: center;
}

.logo-bridge__grid[data-logo-count="3"] {
  display: grid;
  grid-template-columns: repeat(3, minmax(320px, 440px));
  justify-content: center;
  justify-items: center;
}

.logo-bridge__grid[hidden] {
  display: none;
}

.logo-bridge__item {
  --logo-width: 360px;
  --logo-height: 190px;
  --logo-scale: 1.22;
  --logo-x: 0px;
  --logo-y: 0px;
  width: 100%;
  min-width: 0;
  min-height: 200px;
  display: grid;
  place-items: center;
}

.logo-bridge__logo {
  display: block;
  width: min(var(--logo-width), 100%);
  height: var(--logo-height);
  max-width: 100%;
  max-height: none;
  margin-inline: auto;
  object-fit: contain;
  object-position: center;
  opacity: 1;
  transform: translate(var(--logo-x), var(--logo-y)) scale(var(--logo-scale));
  transform-origin: center;
}

.logo-bridge__item[data-logo-name*="smart"] {
  --logo-width: 400px;
  --logo-height: 200px;
  --logo-scale: 1.35;
}

.logo-bridge__item[data-logo-name*="electric"] {
  --logo-width: 360px;
  --logo-height: 210px;
  --logo-scale: 1.35;
  --logo-y: -1px;
}

.logo-bridge__item[data-logo-name*="hilltop"] {
  --logo-width: 390px;
  --logo-height: 200px;
  --logo-scale: 1.30;
}

.logo-bridge__item[data-logo-name*="electric"] .logo-bridge__logo {
  clip-path: inset(12% 9%);
}

.logo-bridge--animate .logo-bridge__intro,
.logo-bridge--animate .logo-bridge__item {
  opacity: 0;
  transform: translateY(16px);
}

.logo-bridge--animate .logo-bridge__intro {
  transition: opacity 520ms ease, transform 520ms ease;
}

.logo-bridge--animate .logo-bridge__item {
  transition: opacity 400ms ease, transform 400ms ease;
}

.logo-bridge--animate .logo-bridge__item:nth-child(2) { transition-delay: 40ms; }
.logo-bridge--animate .logo-bridge__item:nth-child(3) { transition-delay: 80ms; }
.logo-bridge--animate .logo-bridge__item:nth-child(4) { transition-delay: 120ms; }
.logo-bridge--animate .logo-bridge__item:nth-child(5) { transition-delay: 160ms; }
.logo-bridge--animate .logo-bridge__item:nth-child(6) { transition-delay: 200ms; }

.logo-bridge--animate.logo-bridge--visible .logo-bridge__intro,
.logo-bridge--animate.logo-bridge--visible .logo-bridge__item {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1024px) {
  .logo-bridge__intro {
    margin-bottom: 2.5rem;
  }

  .logo-bridge__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .logo-bridge__grid[data-logo-count="2"] {
    grid-template-columns: repeat(2, minmax(230px, 280px));
  }

  .logo-bridge__grid[data-logo-count="3"] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .logo-bridge__item {
