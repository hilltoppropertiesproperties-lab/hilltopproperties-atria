  }
}

@media (max-width: 699px) {
  .section.news-section {
    padding: 48px 0 80px;
  }

  .news-section .news-section__title {
    margin-bottom: 36px;
  }

  .news-grid {
    grid-template-columns: 1fr;
  }

  .news-card__title,
  .news-card__excerpt,
  .news-card__summary {
    min-height: 0;
  }

  .news-navigation {
    gap: 18px;
    margin-top: 40px;
  }

}

@media (prefers-reduced-motion: reduce) {
  .business-snapshot::before,
  .business-snapshot::after {
    animation: none;
  }

  .expertise-scroll__image,
  .expertise-scroll__content,
  .expertise-scroll__progress span,
  .expertise-scroll__link img { transition: none; }
}
