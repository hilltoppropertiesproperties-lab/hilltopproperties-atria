  }

  .logo-bridge__item[data-logo-name*="smart"] {
    --logo-width: 310px;
    --logo-height: 155px;
    --logo-scale: 1.18;
  }

  .logo-bridge__item[data-logo-name*="electric"] {
    --logo-width: 285px;
    --logo-height: 160px;
    --logo-scale: 1.18;
  }

  .logo-bridge__item[data-logo-name*="hilltop"] {
    --logo-width: 305px;
