/* ---------- Color variables (edit here to adjust the whole site) ---------- */
:root {
  --color-navy: #0f2a4a;
  /* primary text, headings, buttons */
  --color-navy-dark: #0a1e36;
  /* hover state for navy buttons */
  --color-blue-light: #eaf1f8;
  /* secondary background */
  --color-blue-border: #c7d9ea;
  /* pale blue borders */
  --color-blue-accent: #3d6ba3;
  /* subtle accent, links on hover */
  --color-white: #ffffff;
  --color-text-muted: #4a5c70;
  /* muted body text */

  --font-heading: 'UNCMMNNominee-LightNormal', Georgia, 'Times New Roman', serif;
  --font-body: Arial, Helvetica, sans-serif;

  --max-width: 1160px;
  --radius: 4px;
}

/* ---------- Reset ---------- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  color: var(--color-navy);
  background-color: var(--color-white);
  line-height: 1.6;
  font-size: 16px;
}

a {
  text-decoration: none;
  color: inherit;
}

ul,
ol {
  list-style: none;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 24px;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: var(--radius);
  font-size: 15px;
  font-weight: 600;
  border: 2px solid transparent;
  cursor: pointer;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.btn-primary {
  background-color: var(--color-navy);
  color: var(--color-white);
  border-color: var(--color-navy);
}

.btn-primary:hover {
  background-color: var(--color-navy-dark);
  border-color: var(--color-navy-dark);
}

.btn-secondary {
  background-color: var(--color-white);
  color: var(--color-navy);
  border-color: var(--color-navy);
}

.btn-secondary:hover {
  background-color: var(--color-blue-light);
}

.btn-small {
  padding: 10px 18px;
  font-size: 14px;
}

/* ---------- Image placeholder (temporary, replace with real images) ---------- */
.image-placeholder {
  background-color: var(--color-blue-light);
  border: 1px dashed var(--color-blue-border);
  color: var(--color-blue-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 14px;
  width: 100%;
  border-radius: var(--radius);
}

/* =========================================================
   HEADER / NAVIGATION
   ========================================================= */
/* =========================================================
   HEADER / NAVIGATION
   ========================================================= */
.site-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  background-color: transparent;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  z-index: 100;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20px;
  padding-bottom: 20px;
  max-width: 100%;
  padding-left: clamp(24px, 4vw, 64px);
  padding-right: clamp(24px, 4vw, 64px);
}

.logo {
  font-family: 'YWFTGrotesk-RegularDemo', Arial, Helvetica, sans-serif;
  font-size: clamp(18px, 1.8vw, 26px);
  font-weight: 700;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
  white-space: nowrap;
  transition: opacity 0.15s ease;
}

.logo:hover {
  opacity: 0.9;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 38px;
  margin-left: auto;
}

.main-nav a {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-white);
  white-space: nowrap;
  transition: opacity 0.15s ease;
}

.main-nav a:hover {
  opacity: 0.8;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 38px;
}

.desktop-menu-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  margin-right: 10px;
  padding: 0;
  background-color: transparent;
  background-image: url('assets/menu-white.svg');
  background-position: center;
  background-repeat: no-repeat;
  background-size: 32px 32px;
  border: none;
  border-left: 1px solid rgba(255, 255, 255, 0.18);
  border-right: 1px solid rgba(255, 255, 255, 0.18);
  cursor: pointer;
  flex-shrink: 0;
  line-height: 0;
  transition: background-color 0.15s ease;
}

.desktop-menu-button img,
.desktop-menu-button svg {
  display: none;
}

.desktop-menu-button:hover {
  background-color: rgba(255, 255, 255, 0.08);
}

.header-action-link {
  color: var(--color-white);
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
  white-space: nowrap;
  padding: 0 24px;
  transition: opacity 0.15s ease;
}

.header-action-link:hover {
  opacity: 0.8;
}

/* Header Action Button - Outlined White */
.site-header .btn-small {
  background-color: rgba(255, 255, 255, 0.08);
  color: var(--color-white);
  border-color: var(--color-white);
  font-size: 14px;
  font-weight: 700;
  padding: 12px 22px;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2);
}

.site-header .btn-small:hover {
  background-color: var(--color-white);
  color: var(--color-navy);
}

/* Mobile nav toggle button (hidden on desktop) */
.nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 18px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
}

.nav-toggle span {
  display: block;
  height: 2px;
  width: 100%;
  background-color: var(--color-white);
  transition: background-color 0.15s ease;
}

/* =========================================================
   HERO SECTION
   ========================================================= */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background-color: var(--color-navy, #102f53);
  background-image: none;
  color: var(--color-white);
  padding: 140px 0 80px 0;
  /* Extra top padding to clear absolute header */
}

.hero>.container {
  position: absolute;
  inset: 0;
  max-width: none;
  padding: 0;
  display: grid;
  place-items: center;
}

.hero-content {
  width: 58%;
  max-width: 1050px;
  min-height: clamp(230px, 27vh, 292px);
  padding: clamp(56px, 7vh, 82px) clamp(40px, 5vw, 76px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 18, 20, 0.55);
  text-align: center;
}

.hero-content h1 {
  font-family: var(--font-heading);
  font-size: clamp(2.75rem, 4vw, 4.6rem);
  line-height: 1;
  color: var(--color-white);
  font-weight: 300;
  letter-spacing: -0.025em;
  white-space: nowrap;
  margin: 0;
  text-align: center;
  text-shadow: none;
}

/* Compact division navigation spanning the hero-to-content transition. */
.division-switcher {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: min(300px, calc(100% - 40px));
  height: 0;
  margin: 0 auto;
  overflow: visible;
}

.division-switcher__link {
  --division-control-border: rgba(255, 255, 255, 0.72);
  --division-control-background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(222, 231, 235, 0.34));
  display: inline-flex;
  flex: 1 1 0;
  position: relative;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 38px;
  padding: 0 10px;
  border: 1px solid var(--division-control-border);
  border-radius: 7px 7px 4px 4px;
  background: var(--division-control-background);
  color: var(--color-navy);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.78),
    0 8px 20px rgba(13, 27, 42, 0.12);
  -webkit-backdrop-filter: blur(14px) saturate(135%);
  backdrop-filter: blur(14px) saturate(135%);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-size: 13px;
  font-weight: 400;
  font-synthesis: none;
  line-height: 1;
  letter-spacing: 0.13em;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  clip-path: polygon(
    9px 0,
    calc(100% - 9px) 0,
    calc(100% - 5px) 2px,
    100% 50%,
    calc(100% - 5px) calc(100% - 2px),
    calc(100% - 9px) 100%,
    9px 100%,
    5px calc(100% - 2px),
    0 50%,
    5px 2px
  );
  filter: drop-shadow(0 8px 10px rgba(13, 27, 42, 0.12));
  transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
}

.division-switcher__link span {
  position: relative;
  z-index: 1;
}

.division-switcher__link.is-active {
  --division-control-border: rgba(176, 220, 246, 0.82);
  --division-control-background:
    linear-gradient(135deg, rgba(11, 111, 184, 0.9), rgba(7, 66, 108, 0.86));
  color: var(--color-white);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.42),
    0 8px 22px rgba(11, 111, 184, 0.22);
  text-shadow: 0 1px 2px rgba(7, 35, 56, 0.28);
}

.division-switcher__link:hover {
  --division-control-border: rgba(255, 255, 255, 0.9);
  --division-control-background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(230, 237, 240, 0.46));
  color: var(--color-navy);
}

.division-switcher__link.is-active:hover {
  --division-control-border: rgba(205, 234, 250, 0.94);
  --division-control-background:
    linear-gradient(135deg, rgba(11, 111, 184, 0.94), rgba(7, 66, 108, 0.9));
  color: var(--color-white);
}

.division-switcher__link:focus-visible {
  outline: 3px solid rgba(61, 107, 163, 0.45);
  outline-offset: 3px;
}

@media (max-width: 420px) {
  .division-switcher {
    gap: 12px;
    width: min(284px, calc(100% - 36px));
  }

  .division-switcher__link {
    min-height: 38px;
    padding-inline: 6px;
    font-size: 12px;
    letter-spacing: 0.1em;
  }
}

/* =========================================================
   GENERIC SECTION STYLES
   ========================================================= */
.section {
  padding: 80px 0;
}

.section-alt {
  background-color: var(--color-blue-light);
}

.section-title {
  font-family: var(--font-heading);
  font-size: 30px;
  font-weight: normal;
  color: var(--color-navy);
  margin-bottom: 40px;
  text-align: center;
}

/* =========================================================
   DISCOVERY BRIDGE SECTION
   ========================================================= */
.discovery-bridge {
  background: var(--color-white);
  padding: 74px 0 64px;
  text-align: center;
}

.discovery-bridge p {
  max-width: 880px;
  margin: 0 auto 42px;
  color: var(--color-navy);
  font-size: clamp(22px, 2vw, 30px);
  font-weight: 400;
  line-height: 1.5;
  text-align: center;
}

.discovery-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150px;
  height: 56px;
  padding: 0 32px;
  background: #0067b1;
  color: var(--color-white);
  font-family: 'Concise-RegularDemo', sans-serif;
  font-size: 15px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  border: none;
  border-radius: var(--radius);
  transition: background-color 0.15s ease;
}

.discovery-button:hover {
  background: #005a9c;
}

/* =========================================================
   EXPLORE OUR WORK SECTION
   ========================================================= */
.work-section {
  background: var(--color-white);
  padding-top: 70px;
  padding-bottom: 80px;
}

.work-section .container {
  max-width: 1500px;
}

.work-section .work-section-header {
  max-width: calc(1285px + 48px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48px;
}

.work-section-header h2,
.news-section .news-section__title {
  font-family: inherit;
  font-size: clamp(3.5rem, 5.5vw, 5.5rem);
  font-weight: 400;
  line-height: 1.05;
  color: #071f3d;
  letter-spacing: -.02em;
}

[data-homepage-hero],
.hero--media-loading,
.hero--media-unavailable {
  background-color: var(--color-navy, #102f53);
  background-image: none;
}

.hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-position: center;
  background-size: cover;
  overflow: hidden;
}

.hero__media video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.hero__background-video {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero--video-playing {
  background-image: none;
}

.hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.hero::after {
  content: none;
}

.hero>.container { z-index: 1; }

.work-section-header h2 {
  margin: 0;
}

.work-section-header a {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #071f3d;
  text-decoration: none;
}

.work-inner {
  display: grid;
  grid-template-columns: 760px 420px;
  column-gap: 105px;
  align-items: center;
  justify-content: center;
}

.work-section--image-right .work-inner {
  grid-template-columns: 420px 760px;
}

.work-content {
  max-width: 420px;
  margin: 0 auto;
  text-align: center;
  align-self: center;
  justify-self: center;
}

.work-content h2 {
  font-family: inherit;
  font-size: clamp(28px, 2.2vw, 38px);
  line-height: 1.15;
  font-weight: 400;
  letter-spacing: 0;
  color: #12345a;
  margin-bottom: 22px;
  text-align: center;
}

.work-content p {
  font-family: inherit;
  font-size: 18px;
  line-height: 1.6;
  font-weight: 400;
  color: #071f3d;
  max-width: 500px;
  margin: 0 auto 42px;
  text-align: center;
}

.work-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  font-family: inherit;
  color: #12345a;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
}

.work-link::after {
  content: "\2192";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  line-height: 1;
}

.work-feature {
  width: 760px;
  max-width: 100%;
  justify-self: start;
}

.work-image {
  width: 100%;
  min-height: 560px;
  aspect-ratio: 5 / 4;
  object-fit: cover;
  background: var(--color-blue-light);
  border: 1px dashed var(--color-blue-border);
}

.work-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* =========================================================
   CARD GRID STYLES
   ========================================================= */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.card {
  border: 1px solid var(--color-blue-border);
  border-radius: var(--radius);
  padding: 20px;
  background-color: var(--color-white);
}

.card-image {
  height: 180px;
  margin-bottom: 16px;
}

.card-category {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--color-blue-accent);
  margin-bottom: 8px;
}

.card-title {
  font-family: var(--font-heading);
  font-size: 19px;
  font-weight: normal;
  color: var(--color-navy);
  margin-bottom: 10px;
}

.card-text {
  font-size: 14.5px;
  color: var(--color-text-muted);
}

/* =========================================================
   EXPERTISE SCROLL STORY
   ========================================================= */
.expertise-scroll { position: relative; height: 400vh; background: var(--color-white); }
.expertise-scroll__sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; padding: 48px 24px; }
.expertise-scroll__media { position: relative; width: 100%; max-width: 1500px; height: calc(100vh - 96px); min-height: 600px; margin: 0 auto; overflow: hidden; background: #071f3d; }
.expertise-scroll__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.02); transition: opacity .38s ease, transform .7s ease; }
.expertise-scroll__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(7,31,61,.18) 0%, rgba(7,31,61,.36) 45%, rgba(7,31,61,.68) 100%); }
.expertise-scroll__content { position: absolute; inset: 0; z-index: 2; display: grid; grid-template-rows: auto 1fr auto; padding: 56px 64px 58px; color: var(--color-white); transition: opacity .28s ease, transform .38s ease; }
.expertise-scroll__eyebrow { display: flex; justify-content: space-between; width: 100%; margin: 0; font-family: 'Concise-RegularDemo', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
.expertise-scroll__heading { align-self: center; max-width: 1100px; margin: 0; color: var(--color-white); font-size: clamp(58px, 5.8vw, 106px); font-weight: 300; line-height: .95; letter-spacing: -.025em; }
.expertise-scroll__body { align-self: end; max-width: 560px; }
.expertise-scroll__text { margin: 0 0 28px; color: var(--color-white); font-size: clamp(19px, 1.45vw, 25px); font-weight: 400; line-height: 1.42; letter-spacing: -.005em; }
.expertise-scroll__link { display: inline-flex; align-items: center; gap: 12px; color: var(--color-white); text-decoration: none; }
.expertise-scroll__link-text { font-family: 'Concise-RegularDemo', sans-serif; font-size: 15px; font-weight: 400; letter-spacing: .06em; }
.expertise-scroll__link img { width: 34px; height: 34px; transition: transform .25s ease; }
.expertise-scroll__link:hover img, .expertise-scroll__link:focus-visible img { transform: translateX(4px); }
.expertise-scroll__progress { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; height: 3px; background: rgba(255,255,255,.2); }
.expertise-scroll__progress span { display: block; width: 25%; height: 100%; background: #60c98f; transition: width .35s ease; }
.expertise-scroll.is-changing .expertise-scroll__image { opacity: 0; transform: scale(1.06); }
.expertise-scroll.is-changing .expertise-scroll__content { opacity: 0; transform: translateY(10px); }
.expertise-scroll__mobile { display: none; }
.expertise-scroll.expertise-scroll--reduced-motion { height: auto !important; padding: 64px 20px; }
.expertise-scroll--reduced-motion .expertise-scroll__sticky { display: none; }
.expertise-scroll--reduced-motion .expertise-scroll__mobile { display: grid; gap: 24px; }
.expertise-scroll--reduced-motion .expertise-card { position: relative; min-height: 520px; overflow: hidden; background: #071f3d; color: var(--color-white); }
.expertise-scroll--reduced-motion .expertise-card__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.expertise-scroll--reduced-motion .expertise-card__overlay { position: absolute; inset: 0; }
.expertise-scroll--reduced-motion .expertise-card__content { position: relative; z-index: 1; min-height: 520px; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px 26px; }
.expertise-scroll--reduced-motion .expertise-card__number { margin: 0 0 auto; font-family: 'Concise-RegularDemo', sans-serif; font-size: 13px; letter-spacing: .08em; }
.expertise-scroll--reduced-motion .expertise-card h2 { margin: 0 0 18px; color: var(--color-white); font-size: clamp(38px, 8vw, 72px); font-weight: 300; line-height: .98; letter-spacing: -.03em; }
